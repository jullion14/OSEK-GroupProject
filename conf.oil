//JX Edits 

CPU mySystem {

  OS myOs {
    EE_OPT = "OS_EE_APPL_BUILD_DEBUG";
    EE_OPT = "OS_EE_BUILD_DEBUG";

    USERESSCHEDULER = FALSE;

    CPU_DATA = AVR8 {
      MULTI_STACK = TRUE;
      IDLEHOOK = TRUE {
        HOOKNAME = "idle_hook";
      };
    };

    MCU_DATA = MEGA {
      MODEL = MEGA_328p;
    };

    LIB = ARDUINO {
      SDK_BOARD = UNO;
      VARIANT = CC {
        VERSION = "1.8.15";
      };
      STAND_ALONE = TRUE;
    };

    KERNEL_TYPE = OSEK {
      CLASS = BCC1;
    };
  };

  APPDATA myApp {
    APP_SRC  = "code.cpp";
    APP_SRC  = "task.cpp";
    APP_SRC  = "debug.cpp";
    APP_SRC  = "LiquidCrystal.cpp";
    APP_SRC  = "ServoTimer2.cpp";
  };

  /* -------- LDR task (higher priority) -------- */
  TASK DetectLightTask {
    PRIORITY = 2;
    SCHEDULE = FULL;
    AUTOSTART = FALSE;
    STACK = SHARED;
    ACTIVATION = 1;
  };

  /* -------- LCD task (lower priority) -------- */
  TASK DisplayTask {
    PRIORITY = 1;
    SCHEDULE = FULL;     /* FULL is fine; NON also works if you never call Schedule() */
    AUTOSTART = FALSE;
    STACK = SHARED;
    ACTIVATION = 1;
  };

  COUNTER SystemTimer {
    MINCYCLE = 1;
    MAXALLOWEDVALUE = 65535;
    TICKSPERBASE = 1;
    TYPE = HARDWARE {
      SYSTEM_TIMER = TRUE;
      PRIORITY     = 1;
      DEVICE       = "TIMER1_COMPA";
    };
    SECONDSPERTICK = 0.001;
  };

  /* Run LDR sampling every 200 ms (example) */
  ALARM AlarmDetectLight {
    COUNTER = SystemTimer;
    ACTION = ACTIVATETASK {
      TASK = DetectLightTask;
    };
    AUTOSTART = TRUE {
      ALARMTIME = 0;
      CYCLETIME = 200;
    };
  };

  /* Run LCD refresh every 500 ms */
  ALARM AlarmDisplay {
    COUNTER = SystemTimer;
    ACTION = ACTIVATETASK {
      TASK = DisplayTask;
    };
    AUTOSTART = TRUE {
      ALARMTIME = 0;
      CYCLETIME = 500;
    };
  };
};
